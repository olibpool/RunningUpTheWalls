[Unit]
Description=Coachal running coach (web app)
After=network-online.target
Wants=network-online.target

[Service]
User=runcoach
WorkingDirectory=/opt/runcoach
EnvironmentFile=/etc/runcoach.env
# Bound to localhost only: `tailscale serve` is the sole way in.
ExecStart=/opt/runcoach/.venv/bin/uvicorn runcoach.web.app:app --host 127.0.0.1 --port 8000 --workers 1
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/runcoach -/home/runcoach/runcoach-inbox -/home/runcoach/.config/runcoach

[Install]
WantedBy=multi-user.target
