# Copy to /etc/runcoach.env, then: sudo chown root:runcoach /etc/runcoach.env && sudo chmod 640 /etc/runcoach.env
RUNCOACH_STORAGE__DB_PATH=/var/lib/runcoach/runcoach.db
RUNCOACH_STORAGE__BACKUP_DIR=/var/backups/runcoach
RUNCOACH_INBOX__PATH=/home/runcoach/runcoach-inbox
# Secret: your Google Calendar "secret address in iCal format".
# RUNCOACH_GCAL__ICS_URL=https://calendar.google.com/calendar/ical/.../basic.ics
# Weather (heat adjustment): your home location.
# RUNCOACH_WEATHER__ENABLED=true
# RUNCOACH_WEATHER__LATITUDE=51.50
# RUNCOACH_WEATHER__LONGITUDE=-0.12
# Optional off-device backup copy, e.g. user@desktop:/backups/runcoach/
# BACKUP_RSYNC_TARGET=
# Garmin: log in once with `sudo -u runcoach -H /opt/runcoach/.venv/bin/python -m runcoach garmin login`
# RUNCOACH_GARMIN__ENABLED=true
# RUNCOACH_EXPORT__BACKEND=garmin
