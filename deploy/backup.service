[Unit]
Description=Coachal nightly database backup

[Service]
Type=oneshot
User=runcoach
WorkingDirectory=/opt/runcoach
EnvironmentFile=/etc/runcoach.env
ExecStart=/opt/runcoach/.venv/bin/python -m runcoach backup
# Optional off-device copy, off by default: set BACKUP_RSYNC_TARGET in /etc/runcoach.env.
ExecStartPost=/bin/sh -c 'if [ -n "$BACKUP_RSYNC_TARGET" ]; then rsync -a /var/backups/runcoach/ "$BACKUP_RSYNC_TARGET"; fi'
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/runcoach /var/backups/runcoach
